# ==============================================================================
# Google Search Console Configuration
# ==============================================================================
# Path to your Google Cloud service account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# OR provide the raw JSON / base64-encoded string of your service account key:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ==============================================================================
# Bing Webmaster Tools Configuration
# ==============================================================================
# API key obtained from Bing Webmaster Tools (Settings -> API Access -> API Key):
BING_WEBMASTER_API_KEY=your_bing_webmaster_api_key_here

# ==============================================================================
# IndexNow Protocol Configuration (Instant indexing for Bing, Yandex, Seznam, etc.)
# ==============================================================================
# IndexNow key hosted at https://yourdomain.com/<key>.txt:
INDEXNOW_KEY=your_indexnow_key_here
# Optional custom key location if not hosted at the domain root:
# INDEXNOW_KEY_LOCATION=https://yourdomain.com/custom-location/key.txt
